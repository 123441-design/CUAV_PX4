<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_cart'>
    <self_collide>false</self_collide>

    <!-- 继承 x500：base_link + 4 旋翼 + 4 电机插件 + imu/mag/气压/navsat 传感器 -->
    <include merge='true'>
      <uri>x500</uri>
    </include>

    <!-- Holybro H-Flow simulation equivalent: downward optical flow + ToF range. -->
    <include merge='true'>
      <uri>model://optical_flow</uri>
      <pose relative_to="base_link">0.03 0 -0.1 0 0 0</pose>
    </include>
    <include merge='true'>
      <uri>model://LW20</uri>
      <pose relative_to="base_link">0 0 -0.079 0 1.57 0</pose>
    </include>
    <joint name="hflow_optical_flow_joint" type="fixed">
      <parent>base_link</parent>
      <child>flow_link</child>
      <pose relative_to="base_link">0 0 -0.1 0 1.5707 0</pose>
    </joint>
    <joint name="hflow_lidar_model_joint" type="fixed">
      <parent>base_link</parent>
      <child>lw20_link</child>
      <pose relative_to="base_link">0 0 0 0 0 0</pose>
    </joint>
    <joint name="hflow_lidar_sensor_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_sensor_link</child>
    </joint>
    <link name="lidar_sensor_link">
      <pose relative_to="base_link">0 0 -0.05 0 1.57 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <sensor name="lidar" type="gpu_lidar">
        <gz_frame_id>lidar_sensor_link</gz_frame_id>
        <pose>0 0 0 3.14 0 0</pose>
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range><min>0.08</min><max>30.0</max><resolution>0.01</resolution></range>
        </ray>
        <always_on>1</always_on>
        <!-- Keep the 50 Hz H-Flow range measurement, but do not render its debug ray. -->
        <visualize>false</visualize>
      </sensor>
    </link>

    <!-- 中柱：把倒装小车抬升到旋翼平面之上（细柱落在中心无桨扫掠区） -->
    <link name="cart_mast">
      <pose relative_to="base_link">0 0 0.09 0 0 0</pose>
      <inertial>
        <!-- Lightweight attachment: keep stock gz_x500 flight dynamics. -->
        <mass>0.001</mass>
        <inertia>
          <ixx>6.08e-7</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>6.08e-7</iyy>
          <iyz>0</iyz>
          <izz>1.5e-7</izz>
        </inertia>
      </inertial>
      <visual name="cart_mast_visual">
        <geometry>
          <box>
            <size>0.03 0.03 0.08</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="cart_mast_collision">
        <geometry>
          <box>
            <size>0.03 0.03 0.08</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="cart_mast_joint" type="fixed">
      <parent>base_link</parent>
      <child>cart_mast</child>
    </joint>

    <!-- 底盘：0.23 × 0.15 × 0.03 m，倒装（在下方），轮子朝上 -->
    <link name="cart_chassis">
      <pose relative_to="base_link">0 0 0.145 0 0 0</pose>
      <inertial>
        <!-- Collision and visuals are retained without changing x500 handling. -->
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-6</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.2417e-5</iyy>
          <iyz>0</iyz>
          <izz>3.1417e-5</izz>
        </inertia>
      </inertial>
      <visual name="cart_chassis_visual">
        <geometry>
          <box>
            <size>0.23 0.15 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.4 0.4 0.45 1</ambient>
          <diffuse>0.4 0.4 0.45 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name="cart_chassis_collision">
        <geometry>
          <box>
            <size>0.23 0.15 0.03</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>

      <!-- Four fixed upward single-beam distance sensors at the wheel locations.
           Their origins sit 30 mm below the wheel tops so a wheel-to-ceiling
           contact still produces a measurable distance instead of an invalid
           zero-range sample. The ray axis is +Z. -->
      <sensor name="cart_lidar_fr" type="gpu_lidar">
        <gz_frame_id>cart_lidar_fr</gz_frame_id>
        <pose>0.09 0.055 0.045 0 -1.5707963 0</pose>
        <update_rate>20</update_rate>
        <ray>
          <scan>
            <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range><min>0.005</min><max>5.0</max><resolution>0.001</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.002</stddev></noise>
        </ray>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
      <sensor name="cart_lidar_fl" type="gpu_lidar">
        <gz_frame_id>cart_lidar_fl</gz_frame_id>
        <pose>0.09 -0.055 0.045 0 -1.5707963 0</pose>
        <update_rate>20</update_rate>
        <ray>
          <scan>
            <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range><min>0.005</min><max>5.0</max><resolution>0.001</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.002</stddev></noise>
        </ray>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
      <sensor name="cart_lidar_rr" type="gpu_lidar">
        <gz_frame_id>cart_lidar_rr</gz_frame_id>
        <pose>-0.09 0.055 0.045 0 -1.5707963 0</pose>
        <update_rate>20</update_rate>
        <ray>
          <scan>
            <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range><min>0.005</min><max>5.0</max><resolution>0.001</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.002</stddev></noise>
        </ray>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
      <sensor name="cart_lidar_rl" type="gpu_lidar">
        <gz_frame_id>cart_lidar_rl</gz_frame_id>
        <pose>-0.09 -0.055 0.045 0 -1.5707963 0</pose>
        <update_rate>20</update_rate>
        <ray>
          <scan>
            <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range><min>0.005</min><max>5.0</max><resolution>0.001</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.002</stddev></noise>
        </ray>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="cart_chassis_joint" type="fixed">
      <parent>base_link</parent>
      <child>cart_chassis</child>
    </joint>

    <!-- 轮子 0（前右） -->
    <link name="cart_wheel_0">
      <pose relative_to="cart_chassis">0.09 0.055 0.045 -1.5707 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>2.58e-7</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.58e-7</iyy>
          <iyz>0</iyz>
          <izz>4.5e-7</izz>
        </inertia>
      </inertial>
      <visual name="cart_wheel_0_visual">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <collision name="cart_wheel_0_collision">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>
    <joint name="cart_wheel_0_joint" type="revolute">
      <pose relative_to="cart_wheel_0" />
      <parent>cart_chassis</parent>
      <child>cart_wheel_0</child>
      <axis>
        <xyz expressed_in='__model__'>0 1 0</xyz>
      </axis>
    </joint>

    <!-- 轮子 1（前左） -->
    <link name="cart_wheel_1">
      <pose relative_to="cart_chassis">0.09 -0.055 0.045 -1.5707 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>2.58e-7</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.58e-7</iyy>
          <iyz>0</iyz>
          <izz>4.5e-7</izz>
        </inertia>
      </inertial>
      <visual name="cart_wheel_1_visual">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <collision name="cart_wheel_1_collision">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>
    <joint name="cart_wheel_1_joint" type="revolute">
      <pose relative_to="cart_wheel_1" />
      <parent>cart_chassis</parent>
      <child>cart_wheel_1</child>
      <axis>
        <xyz expressed_in='__model__'>0 1 0</xyz>
      </axis>
    </joint>

    <!-- 轮子 2（后右） -->
    <link name="cart_wheel_2">
      <pose relative_to="cart_chassis">-0.09 0.055 0.045 -1.5707 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>2.58e-7</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.58e-7</iyy>
          <iyz>0</iyz>
          <izz>4.5e-7</izz>
        </inertia>
      </inertial>
      <visual name="cart_wheel_2_visual">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <collision name="cart_wheel_2_collision">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>
    <joint name="cart_wheel_2_joint" type="revolute">
      <pose relative_to="cart_wheel_2" />
      <parent>cart_chassis</parent>
      <child>cart_wheel_2</child>
      <axis>
        <xyz expressed_in='__model__'>0 1 0</xyz>
      </axis>
    </joint>

    <!-- 轮子 3（后左） -->
    <link name="cart_wheel_3">
      <pose relative_to="cart_chassis">-0.09 -0.055 0.045 -1.5707 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>2.58e-7</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.58e-7</iyy>
          <iyz>0</iyz>
          <izz>4.5e-7</izz>
        </inertia>
      </inertial>
      <visual name="cart_wheel_3_visual">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <collision name="cart_wheel_3_collision">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>
    <joint name="cart_wheel_3_joint" type="revolute">
      <pose relative_to="cart_wheel_3" />
      <parent>cart_chassis</parent>
      <child>cart_wheel_3</child>
      <axis>
        <xyz expressed_in='__model__'>0 1 0</xyz>
      </axis>
    </joint>

  </model>
</sdf>
