#!/usr/bin/expect -f
# Run PX4 SITL and send commands
set timeout 60

# Kill old instances and clean up
exec pkill -9 px4 2>/dev/null
exec rm -f /tmp/px4-sock-0 /tmp/px4_lock-0
sleep 2

# Start PX4
cd $env(HOME)/PX4-test/build/px4_sitl_default
set env(PX4_SYS_AUTOSTART) 10040
spawn ./bin/px4

# Wait for Ready for takeoff
expect {
    "Ready for takeoff!" { puts "\n=== PX4 Ready ===" }
    timeout { puts "\n=== TIMEOUT waiting for ready ==="; exit 1 }
}

# Wait a moment for EKF to settle
sleep 3

# Send commands and capture output
send "listener vehicle_status\r"
sleep 3

send "commander arm\r"
sleep 3

send "commander takeoff\r"
sleep 5

send "listener vehicle_local_position\r"
sleep 3

send "height_commander status\r"
sleep 2

# Done - exit
send "shutdown\r"
sleep 3

puts "\n=== Test complete ==="
