<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="v7_four_post_canopy">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>1 1</size></plane></geometry>
          <surface><friction><ode/></friction><bounce/><contact/></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Single lightweight, deterministic texture for optical-flow tracking. -->
    <include>
      <uri>model://v7_optical_flow_floor</uri>
      <name>v7_optical_flow_floor</name>
      <pose>0 0 0.020 0 0 0</pose>
    </include>

    <model name="four_post_canopy">
      <static>true</static>
      <link name="canopy_roof">
        <!-- Roof top surface is exactly 3.00 m; underside is 2.70 m. -->
        <pose>0 0 2.85 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>10.0 10.0 0.30</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.0 10.0 0.30</size></box></geometry>
          <material><ambient>0.70 0.70 0.70 1</ambient><diffuse>0.70 0.70 0.70 1</diffuse><specular>0.15 0.15 0.15 1</specular></material>
        </visual>
      </link>
      <link name="post_1">
        <pose>4.75 4.75 1.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.30 0.30 2.70</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.30 0.30 2.70</size></box></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse><specular>0.10 0.10 0.10 1</specular></material></visual>
      </link>
      <link name="post_2">
        <pose>4.75 -4.75 1.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.30 0.30 2.70</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.30 0.30 2.70</size></box></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse><specular>0.10 0.10 0.10 1</specular></material></visual>
      </link>
      <link name="post_3">
        <pose>-4.75 4.75 1.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.30 0.30 2.70</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.30 0.30 2.70</size></box></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse><specular>0.10 0.10 0.10 1</specular></material></visual>
      </link>
      <link name="post_4">
        <pose>-4.75 -4.75 1.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.30 0.30 2.70</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.30 0.30 2.70</size></box></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse><specular>0.10 0.10 0.10 1</specular></material></visual>
      </link>
    </model>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation><range>2000</range><linear>0</linear><constant>1</constant><quadratic>0</quadratic></attenuation>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
