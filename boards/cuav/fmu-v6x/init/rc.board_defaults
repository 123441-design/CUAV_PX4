#!/bin/sh
#
# board specific defaults
#------------------------------------------------------------------------------

# Mavlink ethernet (CFG 1000)
param set-default MAV_2_CONFIG 1000
param set-default MAV_2_BROADCAST 1
param set-default MAV_2_MODE 0
param set-default MAV_2_RADIO_CTL 0
param set-default MAV_2_RATE 100000
param set-default MAV_2_REMOTE_PRT 14550
param set-default MAV_2_UDP_PRT 14550

param set-default USB_MAV_MODE 5

# Keep the two physical UART links independent:
# - Standard MAVLink/WiFi owns TELEM2. Project top-distance and motor
#   monitoring frames are sent by streams in that same MAVLink instance.
# - The fused four-laser MAVLink receiver owns TELEM1.
# MAV_0 normally owns TELEM1, so disable that telemetry instance. USB MAVLink
# remains available for QGC, arming, mode selection and manual takeover.
param set-default MAV_0_CONFIG 0
param set-default MAV_1_CONFIG 102
param set-default MAV_1_MODE 0
param set-default MAV_PROTO_VER 2
param set-default MLB_CONFIG 0
param set-default TDB_CONFIG 101
param set-default SER_TEL1_BAUD 115200
param set-default SER_TEL2_BAUD 57600

safety_button start

# CUAV pwm voltage 3.3V/5V switch
pwm_voltage_apply start
